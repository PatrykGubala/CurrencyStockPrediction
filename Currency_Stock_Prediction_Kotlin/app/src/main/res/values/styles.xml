<?xml version="1.0" encoding="utf-8"?>
<resources>


    <style name="RadioButton" parent="@android:style/Widget.CompoundButton.RadioButton">
        <item name="android:button">@color/radio_button_status_color</item>
    </style>



    <!-- FONTS -->

    <style name="KanitLightUltraSmall">
        <item name="android:fontFamily">@font/kanit_light</item>
        <item name="android:textSize">10sp</item>
    </style>

    <style name="KanitLightSmall">
        <item name="android:fontFamily">@font/kanit_light</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="KanitLightMedium">
        <item name="android:fontFamily">@font/kanit_light</item>
        <item name="android:textSize">20sp</item>
    </style>

    <style name="KanitRegularSmall">
        <item name="android:fontFamily">@font/kanit_regular</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="KanitRegularMedium">
        <item name="android:fontFamily">@font/kanit_regular</item>
        <item name="android:textSize">20sp</item>
    </style>

    <style name="KanitRegularLarge">
        <item name="android:fontFamily">@font/kanit_regular</item>
        <item name="android:textSize">24sp</item>
    </style>



    <style name="PinButtonStyle" parent="Widget.MaterialComponents.Button">
        <item name="cornerFamily">rounded</item>
        <item name="cornerRadius">360dp</item>
        <item name="android:backgroundTint">@color/mild_blue</item>

        <item name="android:layout_margin">8dp</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:fontFamily">@font/kanit_light</item>
        <item name="android:textSize">36sp</item>

    </style>


    <style name="CircularShape">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">100%</item>

    </style>

    <style name="PinShapeableButton" parent="Widget.MaterialComponents.Button">
        <item name="shapeAppearanceOverlay">@style/CircularShape</item>
        <item name="backgroundTint">@color/mild_blue</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:fontFamily">@font/kanit_extralight</item>
        <item name="android:textSize">36sp</item>
        <item name="android:layout_margin">8dp</item>
    </style>










</resources>