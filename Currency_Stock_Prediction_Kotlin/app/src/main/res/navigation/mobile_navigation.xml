<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_navigation"
    app:startDestination="@id/homeFragment">

    <fragment
        tools:layout="@layout/fragment_home"
        android:id="@+id/homeFragment"
        android:name="com.example.currencystockprediction.home.HomeFragment"
        android:label="HomeFragment" >

        <action
            android:id="@+id/action_homeFragment_to_notificationsFragment"
            app:destination="@id/notificationsFragment" />
        <action
            android:id="@+id/action_homeFragment_to_currencyFragment"
            app:destination="@id/currencyFragment" />
        <action
            android:id="@+id/action_homeFragment_to_stockFragment"
            app:destination="@id/stockFragment">
        </action>
        <action
            android:id="@+id/action_homeFragment_to_profileFragment"
            app:destination="@id/profileFragment">
        </action>

        <action
            android:id="@+id/action_homeFragment_to_homeDepositFragment"
            app:destination="@id/homeDepositFragment">
        </action>
        <action
            android:id="@+id/action_homeFragment_to_homeSendFragment"
            app:destination="@id/homeSendFragment">
        </action>
        <action
            android:id="@+id/action_homeFragment_to_homeConvertFragment"
            app:destination="@id/homeConvertFragment">
        </action>
        <action
            android:id="@+id/action_homeFragment_to_historyFragment"
            app:destination="@id/historyFragment">
        </action>

    </fragment>
    <fragment
        tools:layout="@layout/fragment_home_history"
        android:id="@+id/historyFragment"
        android:name="com.example.currencystockprediction.home.history.HistoryFragment"
        android:label="historyFragment" >
    </fragment>

    <fragment
        tools:layout="@layout/fragment_home_deposit"
        android:id="@+id/homeDepositFragment"
        android:name="com.example.currencystockprediction.home.deposit.HomeDepositFragment"
        android:label="HomeDepositFragment" >
    </fragment>

    <fragment
        tools:layout="@layout/fragment_home_convert"
        android:id="@+id/homeConvertFragment"
        android:name="com.example.currencystockprediction.home.convert.HomeConvertFragment"
        android:label="HomeConvertFragment" >
    </fragment>

    <fragment
        tools:layout="@layout/fragment_home_send"
        android:id="@+id/homeSendFragment"
        android:name="com.example.currencystockprediction.home.send.HomeSendFragment"
        android:label="HomeSendFragment" >
    </fragment>

    <fragment
        tools:layout="@layout/fragment_notifications"
        android:id="@+id/notificationsFragment"
        android:name="com.example.currencystockprediction.notifications.NotificationsFragment"
        android:label="NotificationsFragment" >
    </fragment>
    <fragment
        tools:layout="@layout/fragment_currency"
        android:id="@+id/currencyFragment"
        android:name="com.example.currencystockprediction.currency.CurrencyFragment"
        android:label="CurrencyFragment" >

        <action
            android:id="@+id/action_currencyFragment_to_currencyDataFragment"
            app:destination="@id/currencyDataFragment" />

    </fragment>

    <fragment
        android:id="@+id/currencyDataFragment"
        android:name="com.example.currencystockprediction.currency.CurrencyDataFragment"
        android:label="Currency Data">
        <argument
            android:name="currencyCode"
            app:argType="string" />
    </fragment>
    <fragment
        tools:layout="@layout/fragment_stock"
        android:id="@+id/stockFragment"
        android:name="com.example.currencystockprediction.stock.StockFragment"
        android:label="StockFragment" >
    </fragment>
    <fragment
        tools:layout="@layout/fragment_profile"
        android:id="@+id/profileFragment"
        android:name="com.example.currencystockprediction.profile.ProfileFragment"
        android:label="ProfileFragment" >
        <action
            android:id="@+id/action_profileFragment_to_profileChangeEmailFragment"
            app:destination="@id/profileChangeEmailFragment">
        </action>
        <action
            android:id="@+id/action_profileFragment_to_profileChangePasswordFragment"
            app:destination="@id/profileChangePasswordFragment">
        </action>
        <action
            android:id="@+id/action_profileFragment_to_profileChangeUsernameFragment"
            app:destination="@id/profileChangeUsernameFragment">
        </action>
        <action
            android:id="@+id/action_profileFragment_to_profileSettingsFragment"
            app:destination="@id/settingsFragment">
        </action>
    </fragment>


    <fragment
        tools:layout="@layout/fragment_profile_settings"
        android:id="@+id/settingsFragment"
        android:name="com.example.currencystockprediction.profile.settings.SettingsFragment"
        android:label="SettingsFragment" >
        <action
            android:id="@+id/action_settingsFragment_to_setPinFragment"
            app:destination="@id/setPinFragment">
        </action>
    </fragment>

    <fragment
        tools:layout="@layout/fragment_profile_change_email"
        android:id="@+id/profileChangeEmailFragment"
        android:name="com.example.currencystockprediction.profile.ProfileChangeEmailFragment"
        android:label="ProfileChangeEmailFragment" >
    </fragment>

    <fragment
        tools:layout="@layout/fragment_profile_change_username"
        android:id="@+id/profileChangeUsernameFragment"
        android:name="com.example.currencystockprediction.profile.ProfileChangeUsernameFragment"
        android:label="ProfileChangeUsernameFragment" >
    </fragment>
    <fragment
        tools:layout="@layout/fragment_profile_change_password"
        android:id="@+id/profileChangePasswordFragment"
        android:name="com.example.currencystockprediction.profile.ProfileChangePasswordFragment"
        android:label="ProfileChangePasswordFragment" >
    </fragment>

    <fragment
        tools:layout="@layout/fragment_set_pin"
        android:id="@+id/setPinFragment"
        android:name="com.example.currencystockprediction.auth.pin.SetPinFragment"
        android:label="SetPinFragment" >



    </fragment>
</navigation>