<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/auth_navigation"
    app:startDestination="@id/startFragment">
    <fragment
        android:id="@+id/splashFragment"
        android:name="com.example.currencystockprediction.auth.splash.SplashFragment"
        android:label="SplashFragment"
        tools:layout="@layout/fragment_splash">

        <action
            android:id="@+id/action_splashFragment_to_startFragment"
            app:destination="@id/startFragment" />
        <action
            android:id="@+id/action_splashFragment_to_pinInputFragment"
            app:destination="@id/pinInputFragment" />
        <action
            android:id="@+id/action_splashFragment_to_setPinFragment"
            app:destination="@id/setPinFragment" />
        <action
            android:id="@+id/action_splashFragment_to_loginFragment"
            app:destination="@id/loginFragment" />
    </fragment>
    <fragment
        tools:layout="@layout/fragment_start"
        android:id="@+id/startFragment"
        android:name="com.example.currencystockprediction.auth.start.StartFragment"
        android:label="StartFragment">
        <action
            android:id="@+id/action_startFragment_to_loginFragment"
            app:destination="@id/splashFragment" />
        <action
            android:id="@+id/action_startFragment_to_registerFragment"
            app:destination="@id/registerFragment" />
    </fragment>

    <fragment
        android:id="@+id/registerFragment"
        android:name="com.example.currencystockprediction.auth.register.RegisterFragment"
        android:label="RegisterFragment">
        <action
            android:id="@+id/action_registerFragment_to_setPinFragment"
            app:destination="@id/setPinFragment" />
    </fragment>

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.currencystockprediction.auth.login.LoginFragment"
        android:label="LoginFragment">
        <action
            android:id="@+id/action_loginFragment_to_pinInputFragment"
            app:destination="@id/pinInputFragment" />

        <action
            android:id="@+id/action_loginFragment_to_setPinFragment"
            app:destination="@id/setPinFragment" />
    </fragment>

    <fragment
        android:id="@+id/pinInputFragment"
        android:name="com.example.currencystockprediction.auth.pin.PinInputFragment"
        android:label="PinInputFragment">
        <action
            android:id="@+id/action_pinInputFragment_to_startFragment"
            app:destination="@id/startFragment" />
    </fragment>

    <fragment
        android:id="@+id/setPinFragment"
        android:name="com.example.currencystockprediction.auth.pin.SetPinFragment"
        android:label="SetPinFragment">
    </fragment>

</navigation>
