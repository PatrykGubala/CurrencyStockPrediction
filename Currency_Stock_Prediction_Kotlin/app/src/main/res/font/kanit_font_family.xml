<?xml version="1.0" encoding="utf-8"?>
<font-family xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Thin -->
    <font
        android:fontStyle="normal"
        android:fontWeight="100"
        android:font="@font/kanit_thin" />

    <font
        android:fontStyle="italic"
        android:fontWeight="100"
        android:font="@font/kanit_thin_italic" />

    <!-- ExtraLight -->
    <font
        android:fontStyle="normal"
        android:fontWeight="200"
        android:font="@font/kanit_extralight" />

    <font
        android:fontStyle="italic"
        android:fontWeight="200"
        android:font="@font/kanit_extralight_italic" />

    <!-- Light -->
    <font
        android:fontStyle="normal"
        android:fontWeight="300"
        android:font="@font/kanit_light" />

    <font
        android:fontStyle="italic"
        android:fontWeight="300"
        android:font="@font/kanit_light_italic" />

    <!-- Regular -->
    <font
        android:fontStyle="normal"
        android:fontWeight="400"
        android:font="@font/kanit_regular" />


    <!-- Medium -->
    <font
        android:fontStyle="normal"
        android:fontWeight="500"
        android:font="@font/kanit_medium" />

    <font
        android:fontStyle="italic"
        android:fontWeight="500"
        android:font="@font/kanit_medium_italic" />

    <!-- SemiBold -->
    <font
        android:fontStyle="normal"
        android:fontWeight="600"
        android:font="@font/kanit_semibold" />

    <font
        android:fontStyle="italic"
        android:fontWeight="600"
        android:font="@font/kanit_semibold_italic" />

    <!-- Bold -->
    <font
        android:fontStyle="normal"
        android:fontWeight="700"
        android:font="@font/kanit_bold" />

    <font
        android:fontStyle="italic"
        android:fontWeight="700"
        android:font="@font/kanit_bold_italic" />

    <!-- ExtraBold -->
    <font
        android:fontStyle="normal"
        android:fontWeight="800"
        android:font="@font/kanit_extrabold" />

    <font
        android:fontStyle="italic"
        android:fontWeight="800"
        android:font="@font/kanit_extrabold_italic" />

    <!-- Black -->
    <font
        android:fontStyle="normal"
        android:fontWeight="900"
        android:font="@font/kanit_black" />

    <font
        android:fontStyle="italic"
        android:fontWeight="900"
        android:font="@font/kanit_black_italic" />

</font-family>
