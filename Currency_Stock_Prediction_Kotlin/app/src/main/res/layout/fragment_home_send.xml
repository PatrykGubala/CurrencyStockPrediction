<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/goBackToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/black"
        android:minHeight="?attr/actionBarSize"
        android:theme="?attr/actionBarTheme"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/back_button"
            android:layout_width="48dp"
            android:layout_height="56dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/login_fragment_title_back_button"
            android:onClick="onBackPressed"
            android:src="@drawable/chevron_left"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/title_text"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:text="Wyślij środki"
            android:textColor="@color/white"
            app:layout_constraintStart_toEndOf="@id/back_button"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            style="@style/KanitRegularLarge" />
    </com.google.android.material.appbar.MaterialToolbar>
    <TextView
        android:id="@+id/accountAmountTextView"
        style="@style/KanitRegularMedium"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:text="Stan konta: ??????"
        android:textColor="@color/white"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/goBackToolbar" />

    <TextView
        android:id="@+id/sendAmountTextView"
        style="@style/KanitLightSmall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:text="Kwota do wysłania:"
        android:textColor="@color/white"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/accountAmountTextView" />


    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/sendAmountTextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/sendAmountTextView">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/sendAmountTextInputEditText"
            style="@style/KanitLightSmall"
            android:layout_width="match_parent"
            android:layout_height="@dimen/fragment_login_input_height"
            android:layout_marginHorizontal="@dimen/fragment_login_textinput_margin_horizontal"

            android:backgroundTint="@color/dark_grey"
            android:hint="Kwota do wysłania:"
            android:inputType="numberDecimal"
            android:textAlignment="viewStart"
            android:textColor="@color/white"
            android:textColorHighlight="@color/grey"
            android:textColorHint="@color/grey"
            android:textColorLink="@color/grey"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:id="@+id/sendPublicAccountTextView"
        style="@style/KanitLightSmall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:text="Numer konta odbiorcy:"
        android:textColor="@color/white"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/sendAmountTextInputLayout" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/sendPublicAccountTextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/sendPublicAccountTextView">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/sendPublicAccountTextInputEditText"
            style="@style/KanitLightSmall"
            android:layout_width="match_parent"
            android:layout_height="@dimen/fragment_login_input_height"
            android:layout_marginHorizontal="@dimen/fragment_login_textinput_margin_horizontal"

            android:backgroundTint="@color/dark_grey"
            android:hint="Numer konta:"
            android:inputType="text"
            android:textAlignment="viewStart"
            android:textColor="@color/white"
            android:textColorHighlight="@color/grey"
            android:textColorHint="@color/grey"
            android:textColorLink="@color/grey"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />
    </com.google.android.material.textfield.TextInputLayout>



    <Button
        android:id="@+id/sendSubmitButton"
        style="@style/KanitRegularMedium"
        android:layout_width="match_parent"
        android:layout_height="@dimen/fragment_login_button_height"
        android:layout_marginHorizontal="@dimen/fragment_login_button_margin_horizontal"
        android:layout_marginBottom="68dp"
        android:background="@drawable/background_style_darkgrey_rectangle"
        android:text="Wyślij"
        android:textAllCaps="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>