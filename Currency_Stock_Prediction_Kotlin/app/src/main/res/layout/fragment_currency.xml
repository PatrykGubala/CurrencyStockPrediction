<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    tools:context=".currency.CurrencyFragment">

    <TextView
        android:id="@+id/europeanCurrenciesTextView"
        style="@style/KanitRegularMedium"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Waluty europejskie"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:textColor="@color/white"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/europeanCurrenciesRecyclerView"
        android:layout_width="0dp"
        android:layout_height="128dp"
        android:layout_marginHorizontal="16dp"
        android:paddingVertical="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/europeanCurrenciesTextView"
        android:background="@drawable/background_style_darkgrey_rectangle_stroke"

        tools:listitem="@layout/fragment_currency_item" />

    <TextView
        android:id="@+id/asianCurrenciesTextView"
        style="@style/KanitRegularMedium"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:text="Waluty azjatyckie"
        android:textColor="@color/white"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/europeanCurrenciesRecyclerView" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/asianCurrenciesRecyclerView"
        android:layout_width="0dp"
        android:layout_height="120dp"
        android:layout_marginHorizontal="16dp"
        android:paddingVertical="4dp"
        android:background="@drawable/background_style_darkgrey_rectangle_stroke"

        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/asianCurrenciesTextView"

        tools:listitem="@layout/fragment_currency_item" />

    <TextView
        android:id="@+id/americanCurrenciesTextView"
        style="@style/KanitRegularMedium"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:text="Waluty amerykańskie"
        android:textColor="@color/white"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/asianCurrenciesRecyclerView" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/americanCurrenciesRecyclerView"
        android:layout_width="0dp"
        android:layout_height="120dp"
        android:layout_marginHorizontal="16dp"
        android:paddingVertical="4dp"
        android:background="@drawable/background_style_darkgrey_rectangle_stroke"

        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/americanCurrenciesTextView"
        tools:listitem="@layout/fragment_currency_item" />


    <TextView
        android:id="@+id/oceanianCurrenciesTextView"
        style="@style/KanitRegularMedium"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:text="Waluty oceańskie heh"
        android:textColor="@color/white"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/americanCurrenciesRecyclerView" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/oceanianCurrenciesRecyclerView"
        android:layout_width="0dp"
        android:layout_height="120dp"
        android:layout_marginHorizontal="16dp"
        android:background="@drawable/background_style_darkgrey_rectangle_stroke"
        android:paddingVertical="4dp"

        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/oceanianCurrenciesTextView"
        tools:listitem="@layout/fragment_currency_item" />

</androidx.constraintlayout.widget.ConstraintLayout>
