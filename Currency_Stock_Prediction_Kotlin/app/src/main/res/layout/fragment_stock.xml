<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    tools:context=".stock.StockFragment">

    <TextView
        android:id="@+id/nyseExchangeTextView"
        style="@style/KanitRegularMedium"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="New York Stock Exchange"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:textColor="@color/white"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/nyseExchangeRecyclerView"
        android:layout_width="0dp"
        android:layout_height="128dp"
        android:layout_marginHorizontal="16dp"
        android:paddingVertical="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/nyseExchangeTextView"
        android:background="@drawable/background_style_darkgrey_rectangle_stroke"

        tools:listitem="@layout/fragment_stock_item" />

    <TextView
        android:id="@+id/xnasExchangeTextView"
        style="@style/KanitRegularMedium"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:text="NASDAQ"
        android:textColor="@color/white"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/nyseExchangeRecyclerView" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/xnasExchangeRecyclerView"
        android:layout_width="0dp"
        android:layout_height="120dp"
        android:layout_marginHorizontal="16dp"
        android:paddingVertical="4dp"
        android:background="@drawable/background_style_darkgrey_rectangle_stroke"

        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/xnasExchangeTextView"

        tools:listitem="@layout/fragment_stock_item" />



</androidx.constraintlayout.widget.ConstraintLayout>
