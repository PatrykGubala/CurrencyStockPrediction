<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent">

    <TextView
        android:id="@+id/accountAmountTextView"
        style="@style/KanitLightLarge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        android:text="Stan konta: $0.00"
        android:textColor="@color/white"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <TextView
        android:id="@+id/publicAccountIdTextView"
        style="@style/KanitLightLarge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginStart="16dp"
        android:text="Numer konta: "
        android:textColor="@color/white"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/accountAmountTextView" />


    <LinearLayout
        android:id="@+id/linearLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:padding="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/publicAccountIdTextView">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/depositButtonLayout"
            android:layout_width="96dp"
            android:layout_height="wrap_content">

            <ImageButton
                android:id="@+id/depositImageButton"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/background_style_mildblue_round_stroke"
                android:contentDescription="Email"
                android:gravity="center_horizontal"
                android:padding="12dp"
                android:scaleType="fitCenter"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/plus" />

            <TextView
                style="@style/KanitLightSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:text="Wpłać"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/depositImageButton" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/contactsButtonLayout"
            android:layout_width="96dp"
            android:layout_height="wrap_content"

            >

            <ImageButton
                android:id="@+id/contactsImageButton"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/background_style_mildblue_round_stroke"
                android:gravity="center_horizontal"
                android:padding="12dp"
                android:scaleType="fitCenter"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/users" />

            <TextView
                style="@style/KanitLightSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:text="Kontakty"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/contactsImageButton" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/sendButtonLayout"
            android:layout_width="96dp"
            android:layout_height="wrap_content"

            >

            <ImageButton
                android:id="@+id/sendImageButton"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/background_style_mildblue_round_stroke"
                android:contentDescription="Email"
                android:gravity="center_horizontal"
                android:padding="12dp"
                android:scaleType="fitCenter"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/arrow_up" />

            <TextView
                style="@style/KanitLightSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:text="Wyślij"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/sendImageButton" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/calculateButtonLayout"
            android:layout_width="96dp"
            android:layout_height="wrap_content"

            >

            <ImageButton
                android:id="@+id/calculateImageButton"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/background_style_mildblue_round_stroke"
                android:contentDescription="Email"
                android:gravity="center_horizontal"
                android:padding="12dp"
                android:scaleType="fitCenter"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/repeat" />

            <TextView
                style="@style/KanitLightSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:text="Przelicz"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/calculateImageButton" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/recentTransactionsLabel"
        style="@style/KanitRegularMedium"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ostatnie Transakcje"
        android:textColor="@color/white"
        android:layout_marginTop="8dp"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/linearLayout" />


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constraintLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:background="@drawable/background_style_darkgrey_rectangle_stroke"
        android:padding="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/recentTransactionsLabel">


        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recentTransactionsRecyclerView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <Button
            android:id="@+id/viewAllTransactionsButton"
            style="@style/KanitLightSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/dark_grey"
            android:text="Zobacz Wszystkie"
            android:textAllCaps="false"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/recentTransactionsRecyclerView" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/currenciesConstraintLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/constraintLayout">

        <TextView
            android:id="@+id/currenciesTextView"
            style="@style/KanitRegularMedium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Moje waluty"
            android:textColor="@color/white"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/europeanCurrenciesRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="102dp"
            android:background="@drawable/background_style_darkgrey_rectangle_stroke"
            android:paddingVertical="4dp"
            app:layout_constraintTop_toBottomOf="@+id/currenciesTextView"
            tools:listitem="@layout/fragment_home_currency_item" />


    </androidx.constraintlayout.widget.ConstraintLayout>


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/stocksConstraintLayout"

        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/currenciesConstraintLayout">

        <TextView
            android:id="@+id/stocksTextView"
            style="@style/KanitRegularMedium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Moje akcje"
            android:textColor="@color/white"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/stocksRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="102dp"
            android:background="@drawable/background_style_darkgrey_rectangle_stroke"
            android:paddingVertical="4dp"
            app:layout_constraintTop_toBottomOf="@+id/stocksTextView"
            tools:listitem="@layout/fragment_home_stock_item" />


    </androidx.constraintlayout.widget.ConstraintLayout>




</androidx.constraintlayout.widget.ConstraintLayout>