<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="8dp"
    android:padding="8dp"
    android:background="@drawable/background_style_black_rectangle_stroke"
    >


    <TextView
        android:id="@+id/contactsTitle"
        style="@style/KanitRegularMedium"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nazwa odbiorcy"
        android:textColor="@color/white"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <TextView
        android:id="@+id/contactsAccountPublicIdTextView"
        style="@style/KanitLightSmall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="1234567890123USD"
        android:textColor="@color/grey"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/contactsTitle" />

    <ImageButton
        android:id="@+id/copyPublicAccountIdImageButton"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:padding="12dp"
        android:backgroundTint="@color/black"
        android:contentDescription="Email"

        android:scaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/copy" />




</androidx.constraintlayout.widget.ConstraintLayout>