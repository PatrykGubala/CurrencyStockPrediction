<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/goBackToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/black"
        android:minHeight="?attr/actionBarSize"
        android:theme="?attr/actionBarTheme"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:titleCentered="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageButton
                android:id="@+id/back_button"
                android:layout_width="48dp"
                android:layout_height="56dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/login_fragment_title_back_button"
                android:onClick="onBackPressed"
                android:src="@drawable/chevron_left"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <TextView
                android:id="@+id/title_text"
                style="@style/KanitRegularLarge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:text="DEFDEF=X"
                android:textColor="@color/white"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="@+id/right_button"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageButton
                android:id="@+id/right_button"
                android:layout_width="48dp"
                android:layout_height="56dp"
                android:layout_marginEnd="16dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.appbar.MaterialToolbar>

    <LinearLayout
        android:id="@+id/chartLayout"

        android:layout_width="match_parent"
        android:layout_height="320dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:padding="0dp"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@+id/goBackToolbar">


        <com.github.mikephil.charting.charts.CandleStickChart
            android:id="@+id/candleStickChart"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible"

            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/goBackToolbar" />

        <com.github.mikephil.charting.charts.LineChart
            android:id="@+id/lineChart"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/goBackToolbar" />

    </LinearLayout>



    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/chartLayout">



        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/scrollableContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="0dp">

            <LinearLayout
                android:id="@+id/buttonContainer"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:layout_marginHorizontal="32dp"
                android:background="@drawable/background_style_darkgrey_rectangle_stroke"
                android:orientation="horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <Button
                    android:id="@+id/lastMonthButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:padding="0dp"
                    android:text="31d"
                    android:textAllCaps="false" />

                <Button
                    android:id="@+id/allDataButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:padding="0dp"
                    android:text="Wszystko"
                    android:textAllCaps="false" />
                <Button
                    android:id="@+id/allDataWithPredictionsButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:padding="0dp"
                    android:text="Predykcja"
                    android:textAllCaps="false" />
            </LinearLayout>

            <TextView
                android:id="@+id/accountOtherCurrencyValueTextView"
                style="@style/KanitLightMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Aktaulny stan: 0.0 ???"
                android:textColor="@color/white"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/buttonContainer" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/amountTextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/accountOtherCurrencyValueTextView">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/amountTextInputEditText"
                    style="@style/KanitLightSmall"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginHorizontal="@dimen/fragment_login_textinput_margin_horizontal"
                    android:backgroundTint="@color/dark_grey"
                    android:hint="Ilość wybranej waluty:"
                    android:inputType="numberDecimal"
                    android:textAlignment="viewStart"
                    android:textColor="@color/white"
                    android:textColorHighlight="@color/grey"
                    android:textColorHint="@color/grey"
                    android:textColorLink="@color/grey"


                    />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/amountCalculatedTextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:clickable="false"
                android:focusable="false"

                android:focusableInTouchMode="false"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/amountTextInputLayout">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/amountCalculatedTextInputEditText"
                    style="@style/KanitLightSmall"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginHorizontal="@dimen/fragment_login_textinput_margin_horizontal"
                    android:backgroundTint="@color/dark_grey"
                    android:clickable="false"
                    android:focusable="false"
                    android:focusableInTouchMode="false"
                    android:hint="Kwota po przeliczeniu z opłatami:"
                    android:inputType="numberDecimal"
                    android:textAlignment="viewStart"
                    android:textColor="@color/white"
                    android:textColorHighlight="@color/grey"
                    android:textColorHint="@color/grey"
                    android:textColorLink="@color/grey"

                    />

            </com.google.android.material.textfield.TextInputLayout>
            <TextView
                android:id="@+id/accountUsdValueTextView"
                style="@style/KanitLightSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:text="Aktualny stan konta USD: $0.00"
                android:textColor="@color/white"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/amountCalculatedTextInputLayout" />


            <LinearLayout
                android:id="@+id/buySellCurrencyLinearLayout"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"

                android:layout_marginHorizontal="@dimen/fragment_login_button_margin_horizontal"
                android:orientation="horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                android:padding="0dp"
                app:layout_constraintTop_toBottomOf="@+id/accountUsdValueTextView" >

                <Button
                    android:id="@+id/buyCurrencyButton"
                    style="@style/KanitRegularMedium"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="@dimen/fragment_login_button_margin_horizontal"

                    android:background="@drawable/background_style_mildblue_rectangle"
                    android:padding="0dp"
                    android:text="Kup"
                    android:textAllCaps="false"
                     />
                <Button
                    android:id="@+id/sellCurrencyButton"
                    style="@style/KanitRegularMedium"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="@dimen/fragment_login_button_margin_horizontal"
                    android:background="@drawable/background_style_red_rectangle"
                    app:backgroundTint="@color/red"
                    android:padding="0dp"
                    android:text="Sprzedaj"
                    android:textAllCaps="false"
                    />

            </LinearLayout>


            <TextView
                android:id="@+id/notificationsTextView"
                style="@style/KanitLightMedium"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Powiadomienia"
                android:textAlignment="center"
                android:textColor="@color/white"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/buySellCurrencyLinearLayout" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/targetPriceTextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toBottomOf="@+id/notificationsTextView">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/targetPriceTextInputEditText"
                    style="@style/KanitLightSmall"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginHorizontal="@dimen/fragment_login_textinput_margin_horizontal"
                    android:backgroundTint="@color/dark_grey"
                    android:hint="Ustaw oczekiwaną kwotę:"
                    android:inputType="numberDecimal"
                    android:textAlignment="viewStart"
                    android:textColor="@color/white"
                    android:textColorHint="@color/grey" />
            </com.google.android.material.textfield.TextInputLayout>

            <Button
                android:id="@+id/setNotificationButton"
                style="@style/KanitRegularMedium"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginHorizontal="@dimen/fragment_login_button_margin_horizontal"
                android:layout_marginTop="8dp"
                android:background="@drawable/background_style_mildblue_rectangle"
                android:padding="0dp"
                android:text="Ustaw powiadomienie"
                android:textAllCaps="false"
                app:layout_constraintTop_toBottomOf="@+id/targetPriceTextInputLayout" />


            <TextView
                android:id="@+id/changeTextView"
                style="@style/KanitLightMedium"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"

                android:text="Zmiana procentowa"
                android:textAlignment="center"
                android:textColor="@color/white"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/setNotificationButton" />

            <androidx.gridlayout.widget.GridLayout
                android:id="@+id/percentageChangesContainer"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="8dp"
                app:columnCount="3"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/changeTextView">

                <TextView
                    android:id="@+id/weeklyChangeTextView"
                    style="@style/KanitLightSmall"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Tygodniowa:"
                    android:textAlignment="center"
                    android:textColor="@color/white"
                    app:layout_columnWeight="1" />

                <TextView
                    android:id="@+id/monthlyChangeTextView"
                    style="@style/KanitLightSmall"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Miesięczna:"
                    android:textAlignment="center"
                    android:textColor="@color/white"
                    app:layout_columnWeight="1" />

                <TextView
                    android:id="@+id/yearlyChangeTextView"
                    style="@style/KanitLightSmall"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Roczna"
                    android:textAlignment="center"
                    android:textColor="@color/white"
                    app:layout_columnWeight="1" />

                <TextView
                    android:id="@+id/weeklyChangePercantageTextView"
                    style="@style/KanitLightSmall"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="0.0%"
                    android:textAlignment="center"
                    android:textColor="@color/white"
                    app:layout_columnWeight="1" />

                <TextView
                    android:id="@+id/monthlyChangePercantageTextView"
                    style="@style/KanitLightSmall"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="0.0%"
                    android:textAlignment="center"
                    android:textColor="@color/white"
                    app:layout_columnWeight="1" />

                <TextView
                    android:id="@+id/yearlyChangePercantageTextView"
                    style="@style/KanitLightSmall"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="0.0%"
                    android:textAlignment="center"
                    android:textColor="@color/white"
                    app:layout_columnWeight="1" />
            </androidx.gridlayout.widget.GridLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>



</androidx.constraintlayout.widget.ConstraintLayout>
